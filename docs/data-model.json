  "exerciseSchema": {
    "description": "Expected shape of each exercise object in exercises.json. See .kiro/steering/exercise-content-guidelines.md for writing rules.",
    "fields": {
      "id": { "type": "string", "required": true, "description": "Unique kebab-case identifier" },
      "name": { "type": "string", "required": true, "description": "Human-readable exercise name" },
      "description": { "type": "string", "required": true, "description": "One to two sentences explaining what the exercise is and how it is performed at a high level." },
      "purpose": { "type": "string", "required": true, "description": "Why this exercise is in a training program. What it builds, what movement pattern it trains." },
      "benefits": { "type": "string", "required": true, "description": "Physiobiological adaptations: tissue changes, injury prevention, hormonal response, movement carryover." },
      "howTo": { "type": "string[]", "required": true, "description": "Numbered steps (array order is step order). Each step starts with a verb. 3 to 6 steps." },
      "commonMistakes": { "type": "string[]", "required": true, "description": "List of mistakes and their fixes. Each item states the mistake then the fix." },
      "muscleGroups": { "type": "string[]", "required": true, "description": "Array of muscle group IDs from the muscleGroups set. First item is primary." },
      "equipment": { "type": "string[]", "required": true, "description": "Array of equipment IDs from the equipment set. Empty array means bodyweight only." },
      "alternatives": { "type": "string[]", "required": false, "description": "Array of exercise IDs that can substitute this exercise. Optional, can be empty." },
      "recommendations": {
        "type": "object",
        "required": false,
        "fields": {
          "reps": { "type": "string", "description": "Recommended rep range (e.g. '8-12')" },
          "sets": { "type": "string", "description": "Recommended set count (e.g. '3-4')" },
          "repUnits": { "type": "string", "description": "Unit of measurement: 'reps', 'secs', 'min'" },
          "note": { "type": "string", "description": "Practical coaching notes, tempo, weight guidance, modifications" }
        }
      },
      "demos": { "type": "array", "required": true, "description": "Array of demo source objects" }
    }
  }
}
